# ─────────────────────────────────────────────────────────────────
# IBKDMS Frontend Environment Variables
# Copy this file to .env and fill in your actual values
# ─────────────────────────────────────────────────────────────────

# Backend API URL
VITE_API_URL=http://localhost:5000/api

# Application Name
VITE_APP_NAME=IBKDMS

# Application Version
VITE_APP_VERSION=1.0.0

# Environment
VITE_ENV=development

# Public app URL (for QR codes on certificates)
VITE_APP_URL=http://localhost:5173

# Use httpOnly cookies instead of localStorage tokens (requires USE_COOKIE_AUTH=true on backend)
VITE_USE_COOKIE_AUTH=false
